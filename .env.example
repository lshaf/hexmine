APP_NAME=HexMine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hexmine
DB_USERNAME=hexmine
DB_PASSWORD=

# §2/§7 -- wallet login. A login is a signed 0.0001 WAX transfer to the account
# below; the window is the ONE number the challenge, the freshness check and the
# replay lock are all derived from (see config/wax.php).
WAX_LOGIN_ACCOUNT=shaf.wiz
WAX_LOGIN_FEE="0.00000001 WAX"
WAX_LOGIN_WINDOW=600
WAX_LOGIN_STORE=redis
WAX_REQUIRE_IRREVERSIBLE=false
WAX_CHAIN_ID=1064487b3cd1a897ce03ae5b6a865651747e2e152090f99c1d19d44e01aea5a4
WAX_CLIENT_ENDPOINT=https://wax.greymass.com
WAX_ENDPOINTS="https://wax.eosusa.io|v2,https://api.waxsweden.org|v2,https://wax.greymass.com|v1"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis, and there is no database fallback: the cache tables are gone and their
# migration with them. App\Game\Tiles keeps hex depletion here and App\Game\Packs
# the cleared flags, so a map read is an MGET over the sight disc and a mine is a
# write -- the hottest path in the game. config/wax.php already pinned the login
# replay lock to Redis, so a box that cannot reach it could never log anyone in
# anyway.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Game
# Compresses all timers for development. 60 = one real hour becomes one minute.
# Set to 1 for true production timings. Server-only: the client is handed
# timeScale in PlayerState (resources/js/game/balance.ts), so there is no
# matching client value and no rebuild is needed to change this.
GAME_TIME_SCALE=1
# Development only: mints a character per session because wallet connect does
# not exist yet. Never enable in production (see config/game.php).
GAME_AUTO_PROVISION=false
# The world. Nothing about the map is stored: every tile is a pure function of
# its coordinates and the seed, so these two values ARE the world and changing
# either moves the ground under every existing character.
# The map is square, so one radius covers it, measured from the middle out: 200
# means -200..200 on both axes, so the grid is 401 a side. Ship value is 2500,
# for the 5000x5000 map. The seed takes hex or decimal, masked to 32 bits.
# After changing either: php artisan game:worldgen-fixture && npm run parity
GAME_MAP_RADIUS=200
GAME_MAP_SEED=0x5eed1a3f
